<launch>
  <arg name="result_directory"/>
  <arg name="run_id"/>
  <arg name="rviz" default="true"/>
  <node pkg="planner_experiments" type="replay_experiment.py" name="planner_experiment_replay"
        output="screen" args="$(arg result_directory) --run-id $(arg run_id)"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find planner_experiments)/rviz/experiment.rviz"/>
</launch>
