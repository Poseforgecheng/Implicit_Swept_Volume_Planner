<launch>
  <arg name="config" default="$(find planner_experiments)/config/experiment_default.yaml"/>
  <arg name="planner_config" default="$(find isweep_planner)/config/planner.yaml"/>
  <arg name="tasks"/>
  <arg name="method" default="current_full"/>
  <arg name="task_id" default="task_001"/>
  <arg name="map_yaml"/>
  <arg name="robot_yaml" default="$(find planner_experiments)/config/robot_shapes/t_shape.yaml"/>
  <arg name="output_dir"/>
  <arg name="run_id"/>
  <arg name="seed" default="1"/>
  <node pkg="planner_experiments" type="experiment_runner_node"
        name="planner_experiments_runner" output="screen"
        args="--config $(arg config) --tasks $(arg tasks) --method $(arg method) --task-id $(arg task_id) --map-yaml $(arg map_yaml) --robot-yaml $(arg robot_yaml) --output-dir $(arg output_dir) --run-id $(arg run_id) --seed $(arg seed)">
    <rosparam command="load" file="$(arg planner_config)"/>
  </node>
</launch>
