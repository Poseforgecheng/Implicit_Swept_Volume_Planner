Panels:
  - Class: rviz/Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
    - Alpha: 0.75
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Occupancy Map
      Topic: /planner_experiments/replay_map
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planner_experiments/replay_markers
      Name: Experiment Replay
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: map
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Scale: 60
Window Geometry:
  Height: 800
  Width: 1200
