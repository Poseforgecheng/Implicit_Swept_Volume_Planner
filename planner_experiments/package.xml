<?xml version="1.0"?>
<package format="2">
  <name>planner_experiments</name>
  <version>0.1.0</version>
  <description>Reproducible offline 2-D batch experiments for isweep_planner.</description>
  <maintainer email="dev@example.com">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>isweep_planner</depend>
  <depend>map_server</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <build_depend>eigen</build_depend>
  <build_depend>libssl-dev</build_depend>
  <build_depend>libyaml-cpp-dev</build_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <test_depend>rostest</test_depend>
</package>
